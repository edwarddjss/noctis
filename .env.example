# MatchNest environment configuration. Copy to .env.local and adjust.
# Everything here is read on the SERVER only (nothing is NEXT_PUBLIC_).

# ---- Sports data -----------------------------------------------------------
# "espn" (default): ESPN's free public soccer JSON. No key needed.
#   Undocumented and unofficial — may change or stop without notice.
# "api-football": licensed API-Sports plan (needs API_FOOTBALL_KEY).
SPORTS_PROVIDER=espn
# Optional overrides (used by tests to point at a local stand-in server)
# ESPN_BASE_URL=https://site.api.espn.com
# ESPN_WEB_BASE_URL=https://site.web.api.espn.com

# API_FOOTBALL_KEY=your-api-football-key-here
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Server-side cache TTLs in seconds. All users share one cache, so upstream
# traffic stays flat no matter how many people use the app.
CACHE_TTL_LIVE=30
CACHE_TTL_FIXTURES=300
CACHE_TTL_STATIC=86400

# Hosts allowed for team/league images (CSP img-src, comma-separated; build time)
IMAGE_HOSTS=a.espncdn.com

# ---- Video (to be decided) -------------------------------------------------
# "none" (default): every match shows "No authorized stream available".
# "config": streams listed in an admin JSON file you have rights to.
STREAM_PROVIDER=none
# STREAM_CONFIG_PATH=./config/authorized-streams.json
# STREAM_HOST_ALLOWLIST=streams.example.com
# ADMIN_API_TOKEN=change-me-to-a-long-random-string

# ---- Optional account sync -------------------------------------------------
SYNC_BACKEND_URL=
