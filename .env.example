# MatchNest environment configuration. Copy to .env.local and fill in.
# Everything here is read on the SERVER only. Nothing is exposed to the browser
# unless it is prefixed NEXT_PUBLIC_ (none of the secrets below are).

# ---- Sports data -----------------------------------------------------------
# "mock" (default, fictional data) or "api-football" (licensed API-Sports plan).
SPORTS_PROVIDER=mock
# API-Sports / API-Football key from https://dashboard.api-football.com
# Placeholder only. Never commit a real key.
API_FOOTBALL_KEY=your-api-football-key-here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Server-side cache TTLs (seconds)
CACHE_TTL_LIVE=20
CACHE_TTL_FIXTURES=300
CACHE_TTL_STATIC=86400

# ---- Authorized streams ----------------------------------------------------
# "mock" (local demo test-pattern media) or "config" (admin JSON file below).
STREAM_PROVIDER=mock
# Admin-maintained list of authorized providers + stream URLs.
STREAM_CONFIG_PATH=./config/authorized-streams.example.json
# Comma-separated hostnames that stream URLs may come from. A stream whose host
# is not in BOTH this list and its provider's allowedHosts is rejected.
STREAM_HOST_ALLOWLIST=streams.example.com
# Bearer token required for the admin stream-validation endpoint.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# ---- Optional account sync -------------------------------------------------
# Leave empty to keep follows on-device only.
SYNC_BACKEND_URL=
